call plug#begin( g:xdg_data_home .. "/vim/plugged" )
    Plug 'Shougo/vimproc.vim', {'do' : 'make'}
    Plug 'gerw/vim-latex-suite'                      " LaTeX editor plugin, '<++>' placeholders
    Plug 'kana/vim-operator-user'
    Plug 'mhinz/vim-startify'                        " Start screen with MRU list and bookmarks
    "Plug 'neoclide/coc.nvim', {'branch' : 'release'} " LSP source annotation, autocompletion, and navigation
    Plug 'potamides/painless-digraph'                " \de to get into digraph mode, \dd to get out
    Plug 'preservim/nerdtree'                        " File browser sidebar (<F9>)
    Plug 'rhysd/vim-clang-format'                    " Auto-formatting using .clang_format file
    Plug 'tpope/vim-dispatch'                        " Run background commands (e.g. builds) without blocking
    Plug 'tpope/vim-fugitive'                        " Git editor plugin, call ':Git' from within Vim
    Plug 'tpope/vim-surround'                        " ds, cs, ys mappings to surround content
    Plug 'vim-scripts/a.vim'                         " ':A' to switch between header and implementation
    Plug 'vim-scripts/taglist.vim'                   " Tag browser sidebar (<F8>)
"    Plug 'vim-scripts/OmniCppComplete'               " Autocompletion / IntelliSense
"    Plug 'tribela/vim-transparent'                   " Overriding background colors so Vim can be transparent
"                                                     " Disabled, as (at least for me) it forces a light background.
"    Plug 'prabirshrestha/vim-lsp'
"    Plug 'maralla/completor.vim'
    Plug 'preservim/vim-markdown'                    " Markdown
    Plug 'powerman/vim-plugin-AnsiEsc'
    Plug 'prabirshrestha/vim-lsp'
    Plug 'prabirshrestha/asyncomplete.vim'
    Plug 'prabirshrestha/asyncomplete-lsp.vim'
    Plug 'mattn/vim-lsp-settings'
call plug#end()

if has_key( plugs, 'vim-lsp' )
    let g:lsp_diagnostics_virtual_text_enabled = 0       " Completely disable virtual text
    let g:lsp_diagnostics_virtual_text_align = 'right'
    let g:lsp_diagnostics_virtual_text_prefix = ' ❯ '

    " 1. Gutter signs (E / W marks in the margin)
    let g:lsp_diagnostics_signs_enabled = 1
    let g:lsp_diagnostics_signs_error = {'text': '✗'}
    let g:lsp_diagnostics_signs_warning = {'text': '▲'}
    let g:lsp_diagnostics_signs_hint = {'text': '●'}
    let g:lsp_diagnostics_signs_information = {'text': 'ℹ'}

    " 2. Text underlines (wavy/colored underlines beneath bad syntax)
    let g:lsp_diagnostics_highlights_enabled = 1

    " 3. Echo error messages in the status line when moving your cursor over them
    let g:lsp_diagnostics_echo_cursor = 1
    let g:lsp_diagnostics_echo_delay = 200     " ms delay before echoing cursor diagnostic

    " 4. Document symbol highlight (highlights all occurrences of the variable under the cursor)
    let g:lsp_document_highlight_enabled = 1   " Set to 0 if distracting

    " Use modern floating/popup windows instead of opening a split preview window
    let g:lsp_preview_float = 1

    " Auto-close the preview/float when the cursor moves away
    let g:lsp_preview_autoclose = 1

    " Keep hover/signature windows readable without folding
    let g:lsp_preview_doubletap = 1 " Double-tap 'K' to jump focus into the float window

    " Minimum characters typed before the popup appears automatically (default: 0)
    " Setting this to 2 or 3 avoids micro-popups on single keystrokes
    let g:asyncomplete_min_chars = 2

    " Milliseconds to debounce/wait before querying the server and drawing the popup
    let g:asyncomplete_popup_delay = 50

    " Set to 0 if you prefer purely manual triggers (<C-Space> or <Tab>) without auto-popups
    let g:asyncomplete_auto_popup = 1

    " Enable fuzzy matching for completion results
    let g:asyncomplete_matchfuzzy = 1

    " Prevent asyncomplete from forcefully overriding your custom 'completeopt'
    let g:asyncomplete_auto_completeopt = 0
    set completeopt=menuone,noinsert,noselect

    " --- Autocompletion UI Settings ---
    " Automatically close preview window when autocompletion is done
    autocmd! CompleteDone * if pumvisible() == 0 | pclose | endif

    " Navigate popup menu using Tab and Shift-Tab
    inoremap <expr> <Tab>   pumvisible() ? "\<C-n>" : "\<Tab>"
    inoremap <expr> <S-Tab> pumvisible() ? "\<C-p>" : "\<S-Tab>"
    inoremap <expr> <cr>    pumvisible() ? asyncomplete#close_popup() : "\<cr>"

    " --- Keybindings & Buffers ---
    function! s:on_lsp_buffer_enabled() abort
        setlocal omnifunc=lsp#complete
        setlocal signcolumn=yes

        " Navigation & Inspection
        nmap <buffer> gd <plug>(lsp-definition)
        nmap <buffer> gr <plug>(lsp-references)
        nmap <buffer> gi <plug>(lsp-implementation)
        nmap <buffer> gt <plug>(lsp-type-definition)
        nmap <buffer> K  <plug>(lsp-hover)
        nmap <buffer> <leader>rn <plug>(lsp-rename)

        " Diagnostics (Errors & Warnings)
        nmap <buffer> [g <plug>(lsp-previous-diagnostic)
        nmap <buffer> ]g <plug>(lsp-next-diagnostic)
    endfunction

    augroup lsp_install
        au!
        autocmd User lsp_buffer_enabled call s:on_lsp_buffer_enabled()
    augroup END
endif

if has_key( plugs, 'vim-latex-suite' )
    set shellslash                                " Convert backward slashes to forward ones in filename references
    set grepprg=grep\ -nH\ $*                     " Force grep to display file name even in single-file searches
    let g:tex_flavor='latex'                      " Force .tex to mean LaTeX, not plain TeX
    let g:Tex_SmartQuoteOpen = "``"               " Opening quote, English style (German would be "\"`")
    let g:Tex_SmartQuoteClose = "''"              " Closing quote, English style (German would be "\"'")
    let g:Tex_AutoFolding = 0                     " Do not fold on opening file
    let g:Tex_Env_table = "\\begin{table}\<CR>\\caption{<++>}\<CR>\\label{tab:<++>}\<CR>\\begin{tabularx}{<+width+>}{<+columns+>}\<CR>\\hline\<CR><++>\<CR>\\hline\<CR>\\end{tabularx}\<CR>\\end{table}<++>"
    let g:Tex_Env_list = "\\begin{lstlisting}[<++>]\<CR><++>\<CR>\\end{lstlisting}<++>"  " list<F5> gives lstlisting environment
    let g:Tex_Com_list = "\\lstinline{<++>}<++>"                                         " list<F7> gives lstinline command
endif

if has_key( plugs, 'vim-startify' )
    let g:startify_session_dir = g:xdg_state_home .. '/vim/session'
    let g:startify_bookmarks = [ { 'r': '~/.config/vim/vimrc' } ]
    let g:startify_custom_indices = map(range(1,100), 'string(v:val)')
    let g:startify_files_number = 3
    let g:startify_session_autoload = 1
    let g:startify_change_to_dir = 0
    let g:startify_session_number = 3
    let g:startify_session_sort = 1
    let g:startify_custom_header= 'startify#center(startify#fortune())'
    let g:startify_custom_header_text = [
                \ '██╗   ██╗██╗███╗   ███╗',
                \ '██║   ██║██║████╗ ████║',
                \ '██║   ██║██║██╔████╔██║',
                \ '╚██╗ ██╔╝██║██║╚██╔╝██║',
                \ ' ╚████╔╝ ██║██║ ╚═╝ ██║',
                \ '  ╚═══╝  ╚═╝╚═╝     ╚═╝'
                \ ]
    let g:startify_custom_header = startify#center( g:startify_custom_header_text )
    let g:startify_relative_path = 1
    let g:startify_use_env = 1
endif

if has_key( plugs, 'nerdtree' )
    nnoremap <silent> <F9> :NERDTreeToggle<CR>
    let g:NERDTreeBookmarksFile = g:xdg_state_home .. '/nerdtree'
    let g:NERDTreeQuitOnOpen = 1
    let g:NERDTreeShowBookmarks = 1
    let g:NERDTreeStatusline = 'NERDTree'
    let g:NERDTreeWinPos = 'right'
    let g:NERDTreeAutoDeleteBuffer = 1
    let g:NERDTreeNaturalSort = 1
    let g:NERDTreeSortOrder = ['\/$', '*']
    let g:NERDTreeSortHiddenFirst = 1
endif

if has_key( plugs, 'vim-clang-format' )
    set textwidth=0
    let g:clang_format#detect_style_file = 1
    let g:clang_format#auto_format_on_insert_leave = 1
    let g:clang_format#auto_formatexpr = 1
    let g:clang_format#enable_fallback_style = 0

    autocmd FileType c,cpp,objc nnoremap <buffer><Leader>cf :<C-u>ClangFormat<CR>
    autocmd FileType c,cpp,objc nnoremap <buffer><Leader>cf :ClangFormat<CR>
    autocmd FileType c,cpp,objc map <buffer><Leader>x <Plug>(operator-clang-format)

    nmap <Leader>C :ClangFormatAutoToggle<CR>
endif

if has_key( plugs, 'vim-dispatch' )
    let b:start = '/bin/bash -l'
endif

if has_key( plugs, 'a.vim' )
    let g:alternateSearchPath = 'sfr:../source,sfr:../src,sfr:../include,sfr:../inc,sfr:../../src'
endif

if has_key( plugs, 'taglist.vim' )
    nnoremap <silent> <F8> :TlistToggle<CR>       " F8 toggles taglist
    let g:Tlist_GainFocus_On_ToggleOpen = 1       " ...give focus...
    let g:Tlist_Exit_OnlyWindow = 1               " ...exit if last window open...
    let g:Tlist_Use_Right_Window = 1              " ...open taglist to the right...
    let g:Highlight_Tag_On_BufEnter = 1           " ...highlight tag when entering buffer...
    let g:Tlist_Auto_Open = 0                     " ...do not open by default...
    let g:Tlist_Auto_Update = 1                   " ...update automatically...
    let g:Tlist_Show_One_File = 0                 " ...show all open files...
    let g:Tlist_Enable_Fold_Column = 0            " ...disable folding...
    let g:Tlist_Use_SingleClick = 1               " ...enable jump-on-click...
endif

if has_key( plugs, 'OmniCppComplete' )
    " Universal Ctags, universal-ctags/ctags-win32
    let OmniCpp_NamespaceSearch = 1
    let OmniCpp_GlobalScopeSearch = 1
    let OmniCpp_ShowAccess = 1
    let OmniCpp_ShowPrototype = 1
    let OmniCpp_ShowPrototypeInAbbr = 1 " Show function signature
    let OmniCpp_MayCompleteDot = 1      " Open after .
    let OmniCpp_MayCompleteArrow = 1    " Open after ->
    let OmniCpp_MayCompleteScope = 1    " Open after ::
    let OmniCpp_SelectFirstItem = 1

    set completeopt=menuone,menu,longest,preview
    set tags=./tags;,tags
    autocmd FileType cpp autocmd BufWritePost <buffer> silent! !ctags -R --c++-kinds=+p+l --fields=+iaS --extra=+q --langmap=c++:+.inl .
    autocmd InsertLeave * if pumvisible() == 0 | pclose | endif
endif

if has_key( plugs, 'vim-markdown' )
    let g:vim_markdown_folding_disabled = 1
endif

if filereadable( g:xdg_config_home .. '/vim/vimrc.plugins.local' )
    exec 'source' g:xdg_config_home .. '/vim/vimrc.plugins.local'
endif
