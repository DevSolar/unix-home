#!/usr/bin/env python3
"""
getapi - Extract and syntax-highlight C/C++ API function declarations with ANSI escape codes.

Features:
- Extracts function declarations and typedefs from raw C/C++ header files.
- Converts return types to trailing return type syntax (`func(...) -> ret_type;`).
- Colorizes:
  - Namespace prefixes (e.g. sds, ini_, parg_, GREATEST_) in Bright Blue
  - Function action names (e.g. cat, parse_file, getopt) in Bold Bright Yellow
  - Argument parameter names (e.g. init, ps, argc, filename) in Bold Cyan
  - Return types (e.g. sds, int, void) in Bold Magenta

To the extent possible under law, the person who associated CC0 with
getapi has waived all copyright and related or neighboring rights to getapi.

You should have received a copy of the CC0 legalcode along with this
work.  If not, see <http://creativecommons.org/publicdomain/zero/1.0/>.
"""

import sys
import os
import re
import argparse

__version__ = "1.1"

C_RESET    = "\033[0m"
C_MAIN_HDR = "\033[1;35m"  # Main Section Titles (bold magenta)
C_CAT_HDR  = "\033[1;36m"  # Category Subheaders (bold cyan)
C_COMMENT  = "\033[32m"    # Comments (green)
C_NS       = "\033[1;93m"  # Namespace prefix (bold bright yellow)
C_ACTION   = "\033[94m"    # Function Action Name (bright blue)
C_RET      = "\033[35m"    # Return Type (magenta)
C_ARG_TYPE = "\033[37m"    # Arg Types (dim white)
C_ARG_NAME = "\033[1;31m"  # Arg Parameter Names (bold cyan)
C_SYNTAX   = "\033[0m"     # parens & arrows (default / white)

def strip_ansi(s):
    return re.sub(r"\033\[[0-9;]*m", "", s)

def split_top_level(s, sep=","):
    """
    Split a string on `sep`, but only where bracket depth is zero.
    Tracks (), [], <> and {} nesting so that nested templates/initializers
    (e.g. `std::pair<long, long>` or `std::vector<std::pair<CString, long>>`)
    are not split on their internal commas.
    """
    parts = []
    depth = 0
    current = []
    i = 0
    n = len(s)
    while i < n:
        c = s[i]
        if c in "([{":
            depth += 1
        elif c in ")]}":
            depth = max(0, depth - 1)
        elif c == "<":
            depth += 1
        elif c == ">":
            depth = max(0, depth - 1)
        elif c == sep and depth == 0:
            parts.append("".join(current))
            current = []
            i += 1
            continue
        current.append(c)
        i += 1
    parts.append("".join(current))
    return parts

BUILTIN_ARG_TYPES = {
    "int", "char", "void", "float", "double", "bool", "long", "short",
    "size_t", "uint8_t", "uint16_t", "uint32_t", "uint64_t", "ssize_t",
    "va_list", "FILE", "wchar_t",
}

def colorize_single_param(param_str):
    m = re.match(
        r"^(?P<type_pre>.*?\b(?:[*&]+\s*)*)(?P<name>[a-zA-Z_]\w*)(?P<type_post>\s*\[.*\])?$",
        param_str,
    )
    if m:
        t_pre = m.group("type_pre")
        name = m.group("name")
        t_post = m.group("type_post") or ""

        if name in BUILTIN_ARG_TYPES and not t_pre.strip():
            return f"{C_ARG_TYPE}{param_str}{C_RESET}"

        return f"{C_ARG_TYPE}{t_pre}{C_ARG_NAME}{name}{C_ARG_TYPE}{t_post}{C_RESET}"

    return f"{C_ARG_TYPE}{param_str}{C_RESET}"

def colorize_args(args_str):
    if not args_str.strip() or args_str.strip() == "void":
        return f"{C_ARG_TYPE}{args_str}{C_RESET}"

    params = split_top_level(args_str, ",")
    colored_params = []

    for param in params:
        param_str = param.strip()
        if param_str == "..." or param_str == "void":
            colored_params.append(f"{C_ARG_TYPE}{param_str}{C_RESET}")
            continue

        # Split off a default value (e.g. `bool a_bFlag = false`) so the
        # parameter name is still detected/colorized correctly.
        default_parts = split_top_level(param_str, "=")
        decl_part = default_parts[0].strip()
        default_part = "=".join(default_parts[1:]).strip() if len(default_parts) > 1 else None

        colored = colorize_single_param(decl_part)
        if default_part is not None:
            colored += f"{C_SYNTAX} = {C_ARG_TYPE}{default_part}{C_RESET}"

        colored_params.append(colored)

    return f"{C_SYNTAX}, {C_RESET}".join(colored_params)

KEYWORDS = {
    "if", "switch", "while", "for", "return", "sizeof", "typedef", "struct",
    "enum", "case", "defined", "define", "goto", "class", "namespace",
    "using", "new", "delete", "throw", "catch", "try", "operator",
    "static_assert", "friend", "public", "private", "protected", "template",
}

# Leading modifiers that are not part of the return type itself and should
# be stripped before extracting the return type text.
LEADING_MODIFIERS = {
    "extern", "static", "inline", "virtual", "explicit", "friend", "mutable",
    "constexpr", "typename", "INI_API", "API", "unsigned", "signed",
    "[[nodiscard]]",
}

def strip_comments_and_strings(text):
    """
    Removes // and /* */ comments, and blanks out the contents of string/char
    literals (keeping delimiters) so bracket-matching later isn't confused by
    braces/parens/quotes that happen to appear inside literals or comments.
    """
    out = []
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        two = text[i:i + 2]
        if two == "//":
            j = text.find("\n", i)
            if j == -1:
                break
            i = j
            continue
        if two == "/*":
            j = text.find("*/", i + 2)
            if j == -1:
                break
            out.append("\n" * text.count("\n", i, j + 2))
            i = j + 2
            continue
        if c in ("\"", "'"):
            quote = c
            out.append(c)
            i += 1
            while i < n and text[i] != quote:
                if text[i] == "\\" and i + 1 < n:
                    i += 2
                else:
                    i += 1
            if i < n:
                out.append(c)
                i += 1
            continue
        out.append(c)
        i += 1
    return "".join(out)

def strip_inline_function_bodies(text):
    """
    Collapses `{ ... }` blocks that are *function bodies* (i.e. braces that
    immediately follow a parameter list's closing `)`, optionally followed by
    `const`/`override`/`final`/`noexcept(...)`) down to `;`.

    Class/struct/enum/namespace bodies are left untouched so their member
    declarations remain visible to the statement parser.
    """
    result = []
    i = 0
    n = len(text)

    def ends_with_word(s, word):
        return s.endswith(word) and (len(s) == len(word) or not (s[-len(word) - 1].isalnum() or s[-len(word) - 1] == "_"))

    def brace_follows_function_signature(back):
        """Strip trailing const/override/final/noexcept(...) qualifiers from
        `back`, then check whether what remains ends with a parameter list's
        closing ')'."""
        stripped = back.rstrip()
        changed = True
        while changed:
            changed = False
            for kw in ("const", "override", "final"):
                if ends_with_word(stripped, kw):
                    stripped = stripped[: -len(kw)].rstrip()
                    changed = True
                    break
            if changed:
                continue
            if stripped.endswith(")"):
                depth = 0
                p = len(stripped) - 1
                while p >= 0:
                    if stripped[p] == ")":
                        depth += 1
                    elif stripped[p] == "(":
                        depth -= 1
                        if depth == 0:
                            break
                    p -= 1
                before = stripped[:p].rstrip()
                if ends_with_word(before, "noexcept"):
                    stripped = before[: -len("noexcept")].rstrip()
                    changed = True
        return stripped.endswith(")")

    while i < n:
        c = text[i]
        if c == "{":
            back = "".join(result)
            is_function_body = brace_follows_function_signature(back)

            depth = 0
            close_idx = -1
            p = i
            while p < n:
                if text[p] == "{":
                    depth += 1
                elif text[p] == "}":
                    depth -= 1
                    if depth == 0:
                        close_idx = p
                        break
                p += 1

            if close_idx == -1:
                result.append(text[i:])
                break

            if is_function_body:
                newlines = text.count("\n", i, close_idx + 1)
                result.append(";" + "\n" * newlines)
            else:
                # Preserve class/struct/enum/namespace bodies, but still
                # recurse in case they themselves contain inline methods.
                inner = strip_inline_function_bodies(text[i + 1:close_idx])
                result.append("{" + inner + "}")

            i = close_idx + 1
            continue

        result.append(c)
        i += 1

    return "".join(result)

def split_statements(text):
    """
    Split cleaned header text into statements, respecting parenthesis/
    angle-bracket nesting so an argument list is never split.

    Splits on ';' as usual, and also on '{'/'}' (which, at this point, only
    remain for class/struct/enum/namespace bodies since function bodies were
    already collapsed to ';'). This lets a constructor immediately following
    a `class X : public Y {` opening be parsed as its own statement instead
    of being merged with the class header.
    """
    statements = []
    current = []
    depth = 0
    for c in text:
        if c in "(<":
            depth += 1
        elif c in ")>":
            depth = max(0, depth - 1)
        if c in ";{}" and depth == 0:
            statements.append("".join(current))
            current = []
        else:
            current.append(c)
    tail = "".join(current).strip()
    if tail:
        statements.append(tail)
    return statements

def strip_leading_modifiers(ret_raw):
    ret = ret_raw.strip()
    changed = True
    while changed:
        changed = False
        ret_stripped = ret.strip()
        m = re.match(r"^\[\[[^\]]*\]\]\s*", ret_stripped)
        if m:
            ret = ret_stripped[m.end():]
            changed = True
            continue
        m = re.match(r"^template\s*<", ret_stripped)
        if m:
            depth = 0
            for idx in range(m.end() - 1, len(ret_stripped)):
                if ret_stripped[idx] == "<":
                    depth += 1
                elif ret_stripped[idx] == ">":
                    depth -= 1
                    if depth == 0:
                        ret = ret_stripped[idx + 1:]
                        changed = True
                        break
            continue
        for kw in LEADING_MODIFIERS:
            m = re.match(rf"^{re.escape(kw)}\b\s*", ret_stripped)
            if m:
                ret = ret_stripped[m.end():]
                changed = True
                break
    return ret.strip()

def find_top_level_paren(stmt):
    """Find the first '(' at bracket-depth 0 and its matching ')'."""
    depth_angle = 0
    open_idx = -1
    for i, c in enumerate(stmt):
        if c == "(" and depth_angle == 0:
            open_idx = i
            break
        elif c == "<":
            depth_angle += 1
        elif c == ">":
            depth_angle = max(0, depth_angle - 1)
    if open_idx == -1:
        return None

    depth = 0
    for i in range(open_idx, len(stmt)):
        if stmt[i] == "(":
            depth += 1
        elif stmt[i] == ")":
            depth -= 1
            if depth == 0:
                return open_idx, i
    return None

def parse_statement(stmt):
    stmt = stmt.strip()
    if not stmt or stmt.startswith("#"):
        return None

    # Drop leading access-specifier labels (public:/private:/protected:) --
    # they don't end with ';' so they stick to the next statement.
    stmt = re.sub(r"^\s*(?:public|private|protected)\s*:\s*", "", stmt).strip()
    if not stmt:
        return None

    if re.match(r"^typedef\b", stmt):
        # Typedefs (incl. function-pointer typedefs) are handled separately.
        return None

    paren_pos = find_top_level_paren(stmt)
    if paren_pos is None:
        return None
    open_idx, close_idx = paren_pos

    pre = stmt[:open_idx]
    args = " ".join(stmt[open_idx + 1:close_idx].split())
    trailing = stmt[close_idx + 1:].strip()

    m = re.search(r"([a-zA-Z_]\w*)\s*$", pre)
    if not m:
        return None
    name = m.group(1)
    if name in KEYWORDS or name.startswith("operator"):
        return None

    ret_raw = pre[:m.start()].strip()
    if not ret_raw:
        # No return type at all -> constructor (or macro-like construct).
        return None
    if ret_raw.endswith("~"):
        # Destructor -> no meaningful return type, skip.
        return None

    ret = strip_leading_modifiers(ret_raw)
    if not ret:
        return None

    ret = " ".join(ret.split())

    is_const = bool(re.search(r"\bconst\b", trailing))
    is_pure = bool(re.search(r"=\s*0\b", trailing))

    suffix = ""
    if is_const:
        suffix += " const"
    if is_pure:
        suffix += " = 0"

    return {
        "is_typedef": False,
        "name": name,
        "args": args,
        "ret": ret,
        "suffix": suffix,
    }

def extract_prototypes_from_header(content):
    """
    Extracts C/C++ function prototypes, methods and function-pointer typedefs
    from raw header file content.
    Returns list of dicts: {'name', 'args', 'ret', 'suffix', 'is_typedef'}
    """
    cleaned = re.sub(r"^\s*#.*$", "", content, flags=re.MULTILINE)
    cleaned = re.sub(r"extern\s+\"C\"\s*\{?", "", cleaned)
    cleaned = strip_comments_and_strings(cleaned)

    # Neutralize comparison-operator overloads (operator<, operator<=, etc.)
    # so their `<`/`>` characters don't unbalance angle-bracket depth
    # tracking used for template detection elsewhere in the file.
    cleaned = re.sub(r"operator\s*(<<=|>>=|<=|>=|<<|>>|<|>)", "operator_cmp", cleaned)

    results = []

    # Typedef function pointer pattern, e.g. `typedef int (*cb)(int, int);`
    typedef_func_pattern = re.compile(
        r"typedef\s+(?P<ret>[^()]+)\s*\(\s*\*\s*(?P<name>\w+)\s*\)\s*\((?P<args>[^)]*)\);",
        re.DOTALL
    )
    for m in typedef_func_pattern.finditer(cleaned):
        ret = " ".join(m.group("ret").split())
        name = m.group("name").strip()
        args = " ".join(m.group("args").split())
        results.append({
            "is_typedef": True,
            "name": name,
            "args": args,
            "ret": ret,
            "suffix": "",
        })

    cleaned_bodies = strip_inline_function_bodies(cleaned)

    for stmt in split_statements(cleaned_bodies):
        parsed = parse_statement(stmt)
        if parsed:
            results.append(parsed)

    return results

def format_and_colorize_api(extracted, prefixes=None):
    all_names = [item['name'] for item in extracted]

    if not prefixes:
        detected = set()
        for name in all_names:
            m = re.match(r"^([a-zA-Z0-9]+_)", name)
            if m:
                detected.add(m.group(1))
            elif name.startswith("sds"):
                detected.add("sds")
        prefixes = list(detected)

    prefixes.sort(key=len, reverse=True)

    output_lines = []

    for item in extracted:
        name = item['name']
        args_str = item['args']
        ret_type = item['ret']
        is_typedef = item.get('is_typedef', False)

        # Separate prefix and action name
        prefix_str = ""
        action_str = name

        for pfix in prefixes:
            if name.startswith(pfix) and len(name) > len(pfix):
                prefix_str = pfix
                action_str = name[len(pfix):]
                break

        colored_args = colorize_args(args_str)
        kw_prefix = "typedef " if is_typedef else ""
        suffix = item.get('suffix', '')

        line_code = (
            f"{C_SYNTAX}{kw_prefix}"
            f"{C_NS}{prefix_str}{C_ACTION}{action_str}{C_SYNTAX}("
            f"{colored_args}{C_SYNTAX}){suffix} -> {C_RET}{ret_type};{C_RESET}"
        )

        output_lines.append(line_code)

    return "\n".join(output_lines) + "\n"

def main():
    parser = argparse.ArgumentParser(
        prog="getapi",
        description="Extract and syntax-highlight C/C++ API function declarations with ANSI escape codes."
    )
    parser.add_argument("file", nargs="?", help="Path to raw C/C++ header file")
    parser.add_argument("-n", "--namespace", action="append", help="Namespace prefix to highlight (e.g. -n sds -n ini_ -n parg_). Can be specified multiple times.")
    parser.add_argument("-o", "--output", help="Output file (default: stdout)")
    parser.add_argument("-v", "-V", "--version", action="version", version=f"%(prog)s v{__version__}")

    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(0)

    args = parser.parse_args()

    if not args.file:
        parser.print_help()
        sys.exit(0)

    if not os.path.exists(args.file):
        sys.exit(f"Error: File '{args.file}' not found.")

    with open(args.file, "r") as f:
        raw_content = f.read()

    raw_content = strip_ansi(raw_content)

    extracted = extract_prototypes_from_header(raw_content)
    colored_text = format_and_colorize_api(extracted, prefixes=args.namespace)

    if args.output:
        with open(args.output, "w") as f:
            f.write(colored_text)
    else:
        sys.stdout.write(colored_text)

if __name__ == "__main__":
    main()
